%% decision: pin compatible Hex releases so a floating Cowboy cannot select an incompatible Cowlib override
{deps, [
    {cowboy, "2.20.0"},
    jsx
]}.

%% decision: replace compound Hex constraints with compatible exact versions for older Rebar solvers
%% TODO(upstream): remove when the supported Rebar minimum handles compound ranges; https://github.com/erlang/rebar3/issues/2364
{overrides, [
    {override, cowboy, [{deps, [{cowlib, "2.21.0"}, {ranch, "2.3.0"}]}]}
]}.

{erl_opts, [no_debug_info]}.

{project_app_dirs, ["apps/timeflies", "apps/timeflies/fable_modules/*"]}.
