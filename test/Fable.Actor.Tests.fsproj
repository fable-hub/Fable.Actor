<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <WarnOn>3390;$(WarnOn)</WarnOn>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Helpers.fs" />
    <Compile Include="ActorTests.fs" />
    <Compile Include="SupervisionTests.fs" />
    <Compile Include="BuilderTests.fs" />
    <Compile Include="LifecycleTests.fs" />
    <Compile Include="CallLivenessTests.fs" />
    <Compile Include="CooperativeTests.fs" />
    <Compile Include="CommandObservations.fs" />
    <Compile Include="CommandTestSupport.fs" />
    <Compile Include="CommandTests.fs" />
    <Compile Include="UnifiedApiTests.fs" />
    <Compile Include="TimefliesExampleTests.fs" />
    <Compile Include="Main.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fable.Core" Version="5.2.0" />
    <PackageReference Include="Scriptorium.Quill" Version="0.5.1" />
    <PackageReference Include="Scriptorium.Nib" Version="0.4.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../src/Fable.Actor/Fable.Actor.fsproj" />
    <!-- decision: the one suite also covers the shared example core, because an example that only
                    compiles is an example whose actor topology was never executed
         invariant: "one suite, one project" bounds the library's API contract, not the number of
                    subjects the suite may exercise
         tradeoff: the library test project now builds an example, so example breakage fails the suite -->
    <ProjectReference Include="../examples/timeflies/src/Timeflies.Common.fsproj" />
  </ItemGroup>
</Project>
